{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/rocm-evidence-matrix/schemas/legacy-linux.schema.json",
  "title": "Legacy Linux ROCm evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "distribution_family", "platform", "sources", "artifact_releases"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "distribution_family": {"const": "legacy"},
    "platform": {"const": "linux"},
    "sources": {"type": "object"},
    "artifact_releases": {"type": "array"}
  }
}
