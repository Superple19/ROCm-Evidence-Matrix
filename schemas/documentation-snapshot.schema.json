{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/rocm-evidence-matrix/schemas/documentation-snapshot.schema.json",
  "title": "ROCm documentation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_observed_at", "sources", "products", "platforms", "windows_release_support", "therock_windows_status", "framework_compatibility"],
  "properties": {
    "schema_version": {"const": 1},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "preferred_url", "fallback_used", "observed_at"],
        "properties": {
          "id": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "preferred_url": {"type": "string", "format": "uri"},
          "fallback_used": {"type": "boolean"},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "architecture", "gfx", "source_id"],
        "properties": {
          "name": {"type": "string"},
          "category": {"enum": ["instinct", "radeon", "radeon_pro", "apu"]},
          "architecture": {"type": "string"},
          "gfx": {"type": "string", "pattern": "^gfx[0-9a-z]+$"},
          "graphics_model": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    },
    "platforms": {
      "type": "object",
      "required": ["windows", "linux"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_support", "therock_status"],
        "properties": {
          "release_support": {"type": "array"},
          "therock_status": {"type": "array"}
        }
      }
    },
    "windows_release_support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gfx", "device_family", "rocm_version", "windows_versions", "selector_ids", "adrenalin_driver_versions", "windows_oem_driver_versions", "source_id"],
        "properties": {
          "gfx": {"type": "string"},
          "device_family": {"type": "string"},
          "rocm_version": {"type": "string"},
          "windows_versions": {"type": "array", "items": {"type": "string"}},
          "selector_ids": {"type": "array", "items": {"type": "string"}},
          "adrenalin_driver_versions": {"type": "array", "items": {"type": "string"}},
          "windows_oem_driver_versions": {"type": "array", "items": {"type": "string"}},
          "source_id": {"type": "string"}
        }
      }
    },
    "therock_windows_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["architecture", "gfx", "build_passing", "sanity_tested", "release_ready", "source_id"],
        "properties": {
          "architecture": {"type": "string"},
          "gfx": {"type": "string"},
          "build_passing": {"type": "boolean"},
          "sanity_tested": {"type": "boolean"},
          "release_ready": {"type": "boolean"},
          "source_id": {"type": "string"}
        }
      }
    },
    "framework_compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["torch_series", "torchaudio_series", "torchvision_series", "source_id"],
        "properties": {
          "torch_series": {"type": "string"},
          "torchaudio_series": {"type": "string"},
          "torchvision_series": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    }
  }
}
