{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/windows-rocm-matrix/schemas/catalog.schema.json",
  "title": "ROCm machine-readable artifact catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "dimensions", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution_families", "platforms", "channels"],
      "properties": {
        "distribution_families": {"type": "array", "items": {"enum": ["therock", "legacy"]}},
        "platforms": {"type": "array", "items": {"enum": ["windows", "linux", "macos", "unknown"]}},
        "channels": {"type": "array", "items": {"enum": ["stable", "nightly", "staging"]}}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "schema", "schema_version"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "schema": {"type": "string"},
          "schema_version": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
