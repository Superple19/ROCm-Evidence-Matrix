{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/rocm-evidence-matrix/schemas/history.schema.json",
  "title": "ROCm historical package catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "sources", "candidates"],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "object"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "distribution_family", "platform", "lifecycle", "channel", "rocm_version", "torch_version", "torchvision_version", "torchaudio_version", "triton_version", "python_tags", "gfx_support", "gfx_targets", "available_gfx_targets", "artifact_available", "evidence_status", "resolver_results", "source_id", "first_observed_at", "last_observed_at"],
        "properties": {
          "id": {"type": "string"},
          "distribution_family": {"enum": ["therock", "legacy"]},
          "platform": {"enum": ["windows", "linux", "macos", "unknown"]},
          "gfx_support": {"enum": ["known", "unknown"]},
          "lifecycle": {"enum": ["current", "historical"]},
          "channel": {"enum": ["stable", "nightly", "staging"]},
          "rocm_version": {"type": "string"},
          "hip_version": {"type": ["string", "null"]},
          "framework_compatibility": {"enum": ["verified", "unknown", "not_collected", "incompatible"]},
          "gfx_support_scope": {"enum": ["release", "series"]},
          "gfx_support_refs": {"type": "array", "items": {"type": "string"}},
          "evidence_status": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {"enum": ["artifact_available", "artifact_stale", "not_collected"]},
              "documentation": {"enum": ["documented", "not_applicable", "unsupported", "unknown", "not_collected"]},
              "ci": {"enum": ["ci_verified", "ci_failed", "partial", "not_collected"]},
              "resolver": {"enum": ["resolver_verified", "resolver_failed", "partial", "not_applicable", "not_collected"]},
              "runtime": {"enum": ["runtime_verified", "runtime_failed", "not_applicable", "not_collected"]},
              "hardware": {"enum": ["hardware_verified", "hardware_failed", "not_applicable", "not_collected"]}
            }
          },
          "resolver_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gfx", "python_tag", "platform_tag", "result", "observed_at"],
              "properties": {
            "candidate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "candidate_id": {"type": "string"},
            "distribution_family": {"enum": ["therock", "legacy"]},
            "platform": {"enum": ["windows", "linux", "macos", "unknown"]},
            "host_platform": {"enum": ["windows", "linux", "macos", "unknown", null]},
            "gfx": {"type": ["string", "null"]},
            "python_tag": {"type": "string"},
            "platform_tag": {"type": "string"},
            "command": {"type": ["array", "null"], "items": {"type": "string"}},
            "exit_code": {"type": ["integer", "null"]},
                "result": {"enum": ["passed", "failed", "not_applicable"]},
                "verification_id": {"type": ["string", "null"]},
                "observed_at": {"type": "string", "format": "date-time"}
                ,"error": {"type": ["string", "null"]}
                ,"snapshot_observed_at": {"type": ["string", "null"], "format": "date-time"}
              }
            }
          },
          "ci_evidence_refs": {"type": "array", "items": {"type": "string"}},
          "ci_evidence_scope": {"enum": ["gfx_platform"]},
          "documentation_refs": {"type": "array", "items": {"type": "string"}},
          "torch_version": {"type": "string"},
          "torchvision_version": {"type": "string"},
          "torchaudio_version": {"type": "string"},
          "triton_version": {"type": ["string", "null"]},
          "python_tags": {"type": "array", "items": {"type": "string", "pattern": "^cp[0-9]+$"}},
          "gfx_targets": {"type": "array", "items": {"type": "string", "pattern": "^gfx[0-9a-z]+$"}},
          "available_gfx_targets": {"type": "array", "items": {"type": "string", "pattern": "^gfx[0-9a-z]+$"}},
          "artifact_available": {"type": "boolean"},
          "source_id": {"type": "string"},
          "wheel_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "first_observed_at": {"type": "string", "format": "date-time"},
          "last_observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
