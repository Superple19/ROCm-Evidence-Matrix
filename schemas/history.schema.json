{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/windows-rocm-matrix/schemas/history.schema.json",
  "title": "ROCm historical package catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "sources", "candidates"],
  "properties": {
    "schema_version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {"type": "object"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "distribution_family", "platform", "lifecycle", "channel", "rocm_version", "torch_version", "torchvision_version", "torchaudio_version", "python_tags", "gfx_support", "gfx_targets", "available_gfx_targets", "artifact_available", "source_id", "first_observed_at", "last_observed_at"],
        "properties": {
          "id": {"type": "string"},
          "distribution_family": {"enum": ["therock", "legacy"]},
          "platform": {"enum": ["windows", "linux", "macos", "unknown"]},
          "gfx_support": {"enum": ["known", "unknown"]},
          "lifecycle": {"enum": ["current", "historical"]},
          "channel": {"enum": ["stable", "nightly", "staging"]},
          "rocm_version": {"type": "string"},
          "hip_version": {"type": ["string", "null"]},
          "evidence_status": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact": {"enum": ["artifact_available", "not_collected"]},
              "resolver": {"enum": ["resolver_verified", "resolver_failed", "not_collected"]},
              "runtime": {"enum": ["runtime_verified", "not_collected"]},
              "hardware": {"enum": ["hardware_verified", "not_collected"]}
            }
          },
          "torch_version": {"type": "string"},
          "torchvision_version": {"type": "string"},
          "torchaudio_version": {"type": "string"},
          "python_tags": {"type": "array", "items": {"type": "string", "pattern": "^cp[0-9]+$"}},
          "gfx_targets": {"type": "array", "items": {"type": "string", "pattern": "^gfx[0-9a-z]+$"}},
          "available_gfx_targets": {"type": "array", "items": {"type": "string", "pattern": "^gfx[0-9a-z]+$"}},
          "artifact_available": {"type": "boolean"},
          "source_id": {"type": "string"},
          "wheel_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "first_observed_at": {"type": "string", "format": "date-time"},
          "last_observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
