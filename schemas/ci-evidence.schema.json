{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "executions", "adapter_failures"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "pattern": "Z$"},
    "executions": {"type": "array"},
    "adapter_failures": {"type": "array"}
  }
}
