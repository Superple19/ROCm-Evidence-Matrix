{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/rocm-evidence-matrix/schemas/extension-snapshot.schema.json",
  "title": "ROCm extension package snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_observed_at", "source", "gfx_targets", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "last_observed_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "distribution_family", "platform", "channel", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "distribution_family": {"enum": ["therock", "legacy", "external"]},
        "platform": {"enum": ["windows", "linux", "macos", "unknown"]},
        "channel": {"enum": ["stable", "nightly", "staging", "external"]},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "gfx_targets": {"type": "array", "maxItems": 0},
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "version", "python_tag", "abi_tag", "platform_tag", "url"],
          "properties": {
            "filename": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "python_tag": {"type": "string", "minLength": 1},
            "abi_tag": {"type": "string", "minLength": 1},
            "platform_tag": {"type": "string", "minLength": 1},
            "build_tag": {"type": ["string", "null"]},
            "requires_dist": {"type": "array", "items": {"type": "string"}},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
            "url": {"type": "string", "format": "uri"}
          }
        }
      }
    }
  }
}
