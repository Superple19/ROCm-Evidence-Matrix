{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Superple19/rocm-evidence-matrix/schemas/package-snapshot.schema.json",
  "title": "ROCm package snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_observed_at",
    "source",
    "gfx_targets",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
        "required": ["id", "distribution_family", "channel", "url", "platform"],
        "properties": {
        "id": {"type": "string", "minLength": 1},
        "distribution_family": {"enum": ["therock", "legacy"]},
        "channel": {"enum": ["stable", "nightly", "staging"]},
        "url": {"type": "string", "format": "uri"},
        "platform": {"enum": ["windows", "linux", "macos", "unknown"]}
      }
    },
    "gfx_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gfx", "device_packages", "all_device_packages_available"],
        "properties": {
          "gfx": {"type": "string", "pattern": "^gfx[0-9a-z]+$"},
          "device_packages": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          },
          "all_device_packages_available": {"type": "boolean"}
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "version", "python_tag", "abi_tag", "platform_tag", "url"],
          "properties": {
            "filename": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "python_tag": {"type": "string", "minLength": 1},
            "abi_tag": {"type": "string", "minLength": 1},
          "platform_tag": {"type": "string", "pattern": "^(win|linux|manylinux|musllinux|any$|source$)"},
        "url": {"type": "string", "format": "uri"},
        "platform": {"enum": ["windows", "linux", "macos", "unknown"]}
          }
        }
      }
    }
  }
}
