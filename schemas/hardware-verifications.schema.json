{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "verifications"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "pattern": "Z$"},
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observed_at", "platform", "host_platform", "os", "result", "correct", "device"],
        "properties": {
          "id": {"type": "string"},
          "candidate_id": {"type": ["string", "null"]},
          "candidate_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "gfx": {"type": ["string", "null"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "python_version": {"type": ["string", "null"]},
          "python_tag": {"type": ["string", "null"]},
          "platform": {"type": ["string", "null"]},
          "host_platform": {"enum": ["windows", "linux", "macos", "unknown"]},
          "platform_detail": {"type": ["string", "null"]},
          "platform_tag": {"type": ["string", "null"]},
          "os": {"enum": ["windows", "linux", "macos", "unknown"]},
          "machine": {"type": ["string", "null"]},
          "architecture": {"type": ["string", "null"]},
          "driver_version": {"type": ["string", "null"]},
          "environment": {"type": "object"},
          "torch_version": {"type": ["string", "null"]},
          "rocm_version": {"type": ["string", "null"]},
          "hip_version": {"type": ["string", "null"]},
          "operation": {"type": ["string", "null"]},
          "command": {"type": ["string", "null"]},
          "device": {"type": ["object", "null"]},
          "elapsed_ms": {"type": ["number", "null"], "minimum": 0},
          "result": {"enum": ["passed", "failed"]},
          "correct": {"type": "boolean"},
          "error": {"type": ["string", "null"]},
          "candidate_match": {"type": ["boolean", "null"]},
          "candidate_errors": {"type": ["array", "null"]}
        }
      }
    }
  }
}
