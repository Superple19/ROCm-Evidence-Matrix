{
  "schema_version": 1,
  "id": "comfyui",
  "name": "ComfyUI ROCm compatibility",
  "profile_kind": "application",
  "metadata": {
    "domain": "generation",
    "status": "baseline",
    "scope": "core runtime only; extensions are separate profiles"
  },
  "evidence_refs": [
    "source:packages-stable",
    "source:packages-nightly",
    "source:packages-stable-linux",
    "source:packages-nightly-linux"
  ],
  "constraints": [
    {
      "id": "rocm-package-candidate",
      "kind": "framework",
      "relationship": "required",
      "name": "ROCm PyTorch package candidate",
      "value": {
        "distribution_families": ["therock", "legacy"],
        "channels": ["stable", "nightly", "staging"]
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-nightly"]
    },
    {
      "id": "torch-rocm",
      "kind": "framework",
      "relationship": "required",
      "name": "PyTorch ROCm",
      "value": {
        "torch_series": ["2.10", "2.11", "2.12", "2.13", "2.14"],
        "selected_from": "history.candidates",
        "version_must_match_rocm_candidate": true
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-nightly", "source:packages-stable-linux"]
    },
    {
      "id": "rocm-channel",
      "kind": "framework",
      "relationship": "required",
      "name": "ROCm package channel",
      "value": {
        "allowed": ["stable", "nightly", "staging"],
        "selection": "explicit"
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-nightly", "source:packages-staging"]
    },
    {
      "id": "supported-platform",
      "kind": "runtime",
      "relationship": "required",
      "name": "Operating system",
      "value": ["windows", "linux"],
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-stable-linux"]
    },
    {
      "id": "platform-package-layout",
      "kind": "runtime",
      "relationship": "required",
      "name": "Platform-specific package layout",
      "value": {
        "windows": {
          "artifact_source": "packages-stable",
          "device_packages": "candidate-specific"
        },
        "linux": {
          "artifact_source": "packages-stable-linux",
          "device_packages": "candidate-specific"
        }
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-stable-linux"]
    },
    {
      "id": "python-tag",
      "kind": "framework",
      "relationship": "required",
      "name": "Python interpreter",
      "value": {
        "selected_from": "candidate.python_tags",
        "requested_by": "resolver"
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-stable-linux"]
    },
    {
      "id": "gfx-target",
      "kind": "runtime",
      "relationship": "required",
      "name": "AMD GFX target",
      "value": {
        "selected_from": "candidate.available_gfx_targets",
        "unknown_support_is_not_auto_compatible": true
      },
      "claim_status": "documented",
      "evidence_refs": ["source:packages-stable", "source:packages-nightly"]
    },
    {
      "id": "disable-cudnn",
      "kind": "option",
      "relationship": "required",
      "name": "Disable cuDNN for the AMD execution path",
      "value": {
        "setting": "torch.backends.cudnn.enabled",
        "value": false
      },
      "conditions": {
        "platform": ["windows", "linux"],
        "distribution_family": ["therock", "legacy"]
      },
      "claim_status": "unverified",
      "evidence_refs": []
    },
    {
      "id": "pinned-memory",
      "kind": "option",
      "relationship": "optional",
      "name": "Pinned host memory",
      "value": {
        "setting": "pin_memory",
        "value": "recommended"
      },
      "conditions": {
        "platform": ["windows", "linux"]
      },
      "claim_status": "unverified",
      "evidence_refs": []
    }
  ]
}
